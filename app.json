{
  "expo": {
    "name": "AnswerForU",
    "slug": "answerforu-site-parity",
    "version": "3.7.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "answerforu",
    "android": {
      "package": "com.answerforu.app",
      "versionCode": 21,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1220"
      }
    },
    "ios": {
      "bundleIdentifier": "com.answerforu.app"
    },
    "plugins": [
      "expo-secure-store",
      "expo-image-picker",
      "expo-document-picker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow AnswerForU to practice spoken civics answers.",
          "speechRecognitionPermission": "Allow AnswerForU to transcribe your practice answers."
        }
      ],
      "expo-notifications",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF3E0",
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#0B1220",
            "image": "./assets/icon.png"
          }
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://answerforu.com",
      "webMasterVersion": "6.4.3",
      "cleanMobileVersion": "3.7.2",
      "googleWebClientId": "816411262872-hhf8r29j0gt9p2russi232ji7vgmq1oj.apps.googleusercontent.com",
      "googleAndroidClientId": "",
      "googleIosClientId": ""
    }
  }
}
